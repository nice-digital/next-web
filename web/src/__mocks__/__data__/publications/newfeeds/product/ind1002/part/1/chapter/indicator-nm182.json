{"Sections":[{"Reference":"IND1002","PartId":1,"ChapterSlug":"section-1","Title":"1.1 Background"},{"Reference":"IND1002","PartId":1,"ChapterSlug":"section-2","Title":"1.2 Measurement"}],"Reference":"IND1002","PartId":1,"ChapterSlug":"indicator-nm182","Content":"<div class=\"chapter\" title=\"Indicator NM182\" id=\"ind1002_indicator-nm182\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n  <h2 class=\"title\">\r\n    <a id=\"indicator-nm182\"></a>Indicator NM182</h2>\r\n  <div class=\"section\" title=\"1.1 Background\" id=\"ind1002_1.1-background\">\r\n    <h3 class=\"title\">\r\n      <a id=\"section-1\"></a>1.1 Background</h3>\r\n    <p>This indicator measures the percentage of patients with diabetes who have received a foot examination.</p>\r\n  </div>\r\n  <div class=\"section\" title=\"1.2 Measurement\" id=\"ind1002_1.2-measurement\">\r\n    <h3 class=\"title\">\r\n      <a id=\"section-2\"></a>1.2 Measurement</h3>\r\n    <p>The measurement period covers the preceding 12 months.</p>\r\n  </div>\r\n</div>"}
